#!/bin/zsh
# Keep the Omnigent lab session alive in INTERACTIVE mode.
# Root cause of the earlier session stops: `omnigent run -p` is ONE-SHOT/headless mode; the client follows the
# session to idle and then deliberately stops it (omnigent/chat.py _run_one_shot -> _stop_headless_session).
# So never pass -p here. Messages are delivered by typing into this REPL (tmux send-keys) or via the web UI.
CONV="$1"; MAX="${2:-20}"
cd "$(dirname "$0")/.." || exit 1
export PATH="$HOME/.local/bin:$PATH"
for i in $(seq 1 "$MAX"); do
  omnigent run lab -r "$CONV"
  bin/falsify log engineer infra_restart "lab-supervisor: interactive omnigent client exited at $(date +%H:%M:%S); re-attaching conversation $CONV (restart $i/$MAX)." >/dev/null
  sleep 5
done
